<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC181818"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/dragHeader"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#DD2B2B2B"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="우마 카운터 (드래그)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="×"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2">

            <Button android:id="@+id/btnCard1" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
            <Button android:id="@+id/btnCard2" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
            <Button android:id="@+id/btnCard3" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />

            <Button android:id="@+id/btnCard4" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
            <Button android:id="@+id/btnCard5" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
            <Button android:id="@+id/btnCard6" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
        </GridLayout>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="초기화"
            android:textSize="11sp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
